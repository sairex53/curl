<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
SFTP
libssh
</keywords>
</info>

# Client-side
<client>
<server>
sftp
</server>
<features>
libssh
</features>
<setenv>
HOME=%PWD/%LOGDIR/ssh-home
SSH_AUTH_SOCK=%PWD/%LOGDIR/ssh-agent.sock
</setenv>
<precheck>
mkdir -p %LOGDIR/ssh-home/.ssh &amp;&amp; cp %LOGDIR/server/curl_client_key %LOGDIR/ssh-home/.ssh/id_rsa &amp;&amp; ssh-keygen -q -p -P "" -N "test-passphrase" -f %LOGDIR/ssh-home/.ssh/id_rsa > /dev/null &amp;&amp; ssh-agent -a %PWD/%LOGDIR/ssh-agent.sock > %LOGDIR/ssh-agent.env &amp;&amp; . %LOGDIR/ssh-agent.env > /dev/null &amp;&amp; ssh-add %LOGDIR/server/curl_client_key > /dev/null 2>&amp;1
</precheck>
<name>
SFTP agent auth with encrypted default key
</name>
<command>
-u %USER: sftp://%HOSTIP:%SSHPORT%SFTP_PWD/%LOGDIR/file%TESTNUMBER.txt --insecure
</command>
<file name="%LOGDIR/file%TESTNUMBER.txt">
Test data
for ssh test
</file>
</client>

# Verify data after the test has been "shot"
<verify>
<stdout>
Test data
for ssh test
</stdout>
<postcheck>
. %LOGDIR/ssh-agent.env > /dev/null &amp;&amp; ssh-agent -k > /dev/null 2>&amp;1
</postcheck>
</verify>
</testcase>
